# Tool versions every machine converges on. sync installs exactly this
# version when a tool is older (or missing) and leaves a newer one alone.
# Raise a pin here, merge, then run `setup.sh sync` on each machine.
# shellcheck shell=bash disable=SC2034  # sourced by lib/sync.sh
RTK_VERSION=1.2.1        # must stay >= 0.38.0 (`rtk hook claude` form)
GRAPHIFY_VERSION=0.9.120 # PyPI graphifyy, installed with uv
CODEX_VERSION=0.172.0    # official standalone installer (--release)
OMO_VERSION=5.1.83       # npm omo-ai
HC_VERSION=0.1.22        # herdr-core; `hc update --version` keeps terminals running
