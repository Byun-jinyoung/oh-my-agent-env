#!/usr/bin/env python3
"""Show the Antigravity desktop app (agy-app) as a herdr agent.

agy-app's agent runs outside any herdr terminal, so it has no tty to report OSC 7501 on.
This keeps a stand-in hc terminal named "agy-app" (its own tab in the Mac's local space) and
writes the app's state to that terminal's tty from agy hooks. The hook file
(~/.gemini/config/hooks.json) is shared with agy-cli; agy-cli reports OSC 7501 natively,
so hooks it runs are ignored here (inside an OMS panel's tmux, herdr-tmux-osc relays them).

  agy-app-herdr hook <Event>   agy hook entry (payload on stdin); always exits 0
  agy-app-herdr up             start the stand-in terminal and its tab if missing
  agy-app-herdr serve          the stand-in's program: record its tty, replay the state, wait
  agy-app-herdr status         print the per-conversation states and what is shown

Limit: agy has no permission-request hook and PreToolUse runs before the approval prompt,
so an app tool-approval wait shows as working. Questions (ask_question) show as blocked.
"""
import fcntl, json, os, signal, stat, subprocess, sys, time

NAME = 'agy-app'
APP = 'antigravity'
DIR = os.path.expanduser('~/.local/state/agy-app-herdr')
CONV = os.path.join(DIR, 'conv')
# A working entry with no hook event for this long is a turn the app dropped (quit, crash).
WORKING_TTL = 20 * 60
KEEP_TTL = 24 * 3600
RANK = {'blocked': 3, 'working': 2, 'done': 1}


def log(msg):
    path = os.path.join(DIR, 'log')
    try:
        if os.path.getsize(path) > 200_000:
            os.replace(path, path + '.1')
    except OSError:
        pass
    with open(path, 'a') as f:
        f.write(f'{time.strftime("%F %T")} {msg}\n')


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def write(path, text):
    tmp = f'{path}.{os.getpid()}'
    with open(tmp, 'w') as f:
        f.write(text)
    os.replace(tmp, path)


# --- which agy ran the hook -------------------------------------------------------------

def caller():
    """'app' under the desktop app, 'cli' under agy-cli, else None."""
    out = subprocess.run(['ps', '-axo', 'pid=,ppid=,comm='], capture_output=True, text=True).stdout
    procs = {}
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3:
            procs[parts[0]] = (parts[1], os.path.basename(parts[2]))
    pid = str(os.getppid())
    for _ in range(12):
        if pid not in procs:
            return None
        ppid, comm = procs[pid]
        if comm == 'agy':
            return 'cli'
        if comm.startswith(('language_server', 'Antigravity')):
            return 'app'
        pid = ppid
    return None


# --- state ------------------------------------------------------------------------------

def shown():
    """The most urgent live conversation state: (state, kind, msg)."""
    now, best = time.time(), None
    for name in os.listdir(CONV):
        path = os.path.join(CONV, name)
        try:
            e = json.loads(read(path, '{}'))
        except ValueError:
            e = {}
        age = now - e.get('t', 0)
        if age > KEEP_TTL or (e.get('state') == 'working' and age > WORKING_TTL):
            os.unlink(path)
            continue
        key = (RANK.get(e.get('state'), 0), e.get('t', 0))
        if best is None or key > best[0]:
            best = (key, e)
    if not best:
        return 'idle', None, None
    e = best[1]
    return e['state'], e.get('kind'), e.get('msg')


def sequence(state, kind=None):
    # No msg: herdr ignored every msg encoding tried, and a malformed one drops the whole report.
    fields = [f'state={state}']
    if kind:
        fields.append(f'kind={kind}')
    fields.append(f'app={APP}')
    return f'\x1b]7501;{":".join(fields)}\x1b\\'.encode()


def write_tty(tty, data):
    if not tty or not tty.startswith('/dev/'):
        return False
    try:
        fd = os.open(tty, os.O_WRONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        if not stat.S_ISCHR(os.fstat(fd).st_mode):
            return False
        os.write(fd, data)
    finally:
        os.close(fd)
    return True


def send():
    state, kind, _ = shown()
    return write_tty(read(os.path.join(DIR, 'tty')), sequence(state, kind))




def serving():
    pid = read(os.path.join(DIR, 'pid'))
    try:
        os.kill(int(pid), 0)
        return True
    except (TypeError, ValueError, OSError):
        return False


# --- hook -------------------------------------------------------------------------------

def question(call):
    args = call.get('args')
    if isinstance(args, str):
        try:
            args = json.loads(args)
        except ValueError:
            return args[:200]
    if isinstance(args, dict):
        for k in ('question', 'questions', 'prompt', 'text', 'message'):
            v = args.get(k)
            if isinstance(v, list) and v:
                v = v[0].get('question') if isinstance(v[0], dict) else v[0]
            if isinstance(v, str) and v:
                return v[:200]
    return None


def hook(event):
    raw = sys.stdin.read()
    # agy reads stdout as the hook's answer: empty for PreToolUse is the only neutral one
    # ("ask"/{} change approval); Stop needs a decision other than "continue".
    if event == 'Stop':
        print('{"decision":""}')
    elif event != 'PreToolUse':
        print('{}')
    sys.stdout.flush()
    if caller() != 'app':
        return
    try:
        p = json.loads(raw or '{}')
    except ValueError:
        p = {}
    call = p.get('toolCall') or {}
    conv = str(p.get('conversationId') or 'unknown').replace('/', '_')
    path = os.path.join(CONV, conv)
    entry = {'state': 'working'}
    if event == 'PreToolUse' and call.get('name') == 'ask_question':
        entry = {'state': 'blocked', 'kind': 'question', 'msg': question(call)}
    elif event == 'Stop':
        idle = p.get('fullyIdle', True)
        if idle is True or str(idle).lower() == 'true':
            entry = {'state': 'done'}
    elif event == 'SessionStart':
        entry = None
    if entry:
        entry['t'] = time.time()
        write(path, json.dumps(entry))
    if not serving():
        subprocess.Popen([os.path.abspath(__file__), 'up'], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return
    send()


# --- stand-in terminal ------------------------------------------------------------------

def j(*cmd):
    return json.loads(subprocess.run(cmd, capture_output=True, text=True, check=True).stdout)


def find():
    ls = j('hc', 'ls', '--json')
    for t in ls if isinstance(ls, list) else ls.get('terminals', []):
        if t.get('name') == NAME and t.get('state') == 'live':
            return t['address']
    return None


def pane_space():
    """(space holding the stand-in's pane or None, local space id, active space id)."""
    d = j('herdr-app', 'ls')
    addr = find()
    where = next((s['id'] for s in d['spaces'] for tb in s['tabs'] for t in tb['terminals']
                  if t['terminal'] == addr and t.get('pane')), None)
    local = os.environ.get('AGY_APP_HERDR_SPACE') or next((s['id'] for s in d['spaces'] if '/' not in s['id']), None)
    active = next((s['id'] for s in d['spaces'] if s.get('active')), None)
    return where, local, active


def select(sid):
    for _ in range(10):
        subprocess.run(['herdr-app', 'do', 'space.select', json.dumps({'id': sid})], capture_output=True)
        time.sleep(0.5)
        if pane_space()[2] == sid:
            return True
    return False


def up():
    with open(os.path.join(DIR, 'lock'), 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        addr = find()
        if addr and not serving():
            # keep turned a dead `serve` into a shell: replace the terminal
            log(f'up: {addr} has no serve; replacing')
            subprocess.run(['hc', 'kill', addr], capture_output=True)
            subprocess.run(['hc', 'rm', addr], capture_output=True)
            addr = None
        if not addr:
            ls = j('hc', 'ls', '--json')
            for t in ls if isinstance(ls, list) else ls.get('terminals', []):
                if t.get('name') == NAME and t.get('state') != 'live':
                    subprocess.run(['hc', 'rm', t['address']], capture_output=True)
            # --no-parent: a stand-in for the app, not anyone's sub-agent; must not end with
            # whatever terminal `up` happened to be run from.
            r = subprocess.run(['hc', 'run', '--bg', '--json', '--name', NAME, '--no-parent', '--no-notify',
                                '--outlive-parent', '--cwd', os.path.expanduser('~'), '--',
                                os.path.abspath(__file__), 'serve'], capture_output=True, text=True)
            if r.returncode:
                log(f'up: hc run failed: {r.stderr.strip()[:200]}')
                return 1
            for _ in range(20):
                if serving() and (addr := find()):
                    break
                time.sleep(0.25)
            log(f'up: started {addr}')
        try:
            where, local, active = pane_space()
        except (OSError, subprocess.CalledProcessError, ValueError) as e:
            log(f'up: herdr-app unavailable, no tab: {e}')
            return 0
        if addr and not where and local:
            # keep puts the tab in the active space: make the local space active for it
            if select(local):
                subprocess.run(['herdr-app', 'do', 'terminal.keep', '--terminal', addr], capture_output=True)
            if active and active != local:
                select(active)
            log(f'up: kept {addr} in {local} (now {pane_space()[0]})')
        print(addr or '')
    return 0


def serve():
    write(os.path.join(DIR, 'tty'), os.ttyname(0))
    write(os.path.join(DIR, 'pid'), str(os.getpid()))
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    send()
    print('agy-app 상태 표시용 탭입니다. 여기는 대화창이 아닙니다.\n'
          '대화는 Antigravity 앱 창에서 하세요. Enter를 누르면 그 창을 앞으로 가져옵니다.\n'
          '이 탭을 닫으면 Herdr에서 agy-app 상태가 사라집니다(다시 열기: agy-app-herdr up).')
    sys.stdout.flush()
    # The app's chat can't live in a terminal: a typed line only brings the app window forward.
    for _ in sys.stdin:
        try:
            subprocess.run(['open', '-a', 'Antigravity'], capture_output=True)
            print('→ Antigravity 앱 창을 앞으로 가져왔습니다.')
        except OSError:  # no `open` (Linux): the app window is on another machine
            print('→ 이 머신에서는 앱 창을 열 수 없습니다.')
        sys.stdout.flush()
    while True:
        signal.pause()


def status():
    for name in sorted(os.listdir(CONV)):
        print(name, read(os.path.join(CONV, name)))
    print('shown:', shown(), 'serving:', serving(), 'tty:', read(os.path.join(DIR, 'tty')))
    return 0


def main():
    os.makedirs(CONV, exist_ok=True)
    cmd = sys.argv[1] if len(sys.argv) > 1 else ''
    if cmd == 'hook':
        try:
            hook(sys.argv[2] if len(sys.argv) > 2 else '')
        except Exception as e:  # a hook must never fail the agent's turn
            log(f'hook {sys.argv[2:]}: {type(e).__name__}: {e}')
        return 0
    if cmd in ('up', 'serve', 'status'):
        return {'up': up, 'serve': serve, 'status': status}[cmd]() or 0
    print(__doc__)
    return 2


if __name__ == '__main__':
    sys.exit(main())
