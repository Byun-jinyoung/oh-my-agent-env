#!/usr/bin/env bash
# One entry point for the experiment tools, so a research repo needs one name on
# PATH instead of four absolute paths into this harness.
#
#   oma-lab run <cmd>...        record a run: gate, execute, append to the ledger
#   oma-lab top --metric KEY    rank past runs by a recorded metric
#   oma-lab capsule <verb>      reproducibility bundle for a run
#   oma-lab board <verb>        claim an experiment id so two sessions cannot duplicate it
#   oma-lab fail <verb>         cross-session memory of failed commands
#   oma-lab data <verb>         fingerprint the splits a number was trained on
#
# Every tool writes into the CURRENT repo, never into this harness:
#
#   .oma-lab/ledger.jsonl       one row per run
#   .oma-lab/experiments.jsonl  claims, from `board`
#   .oma-lab/failures.jsonl     known-broken commands, from `fail`
#   .oma-lab/datasets.jsonl     split fingerprints, from `data`
#   .oma-lab/capsules.jsonl     capsule index
#   .oma-lab/runs/<run-id>/     the capsule contents themselves
#   .oma-lab/CURRENT            the run id the other verbs join against
set -uo pipefail

LAB_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lab" && pwd -P)"
export LAB_DIR

# Render the whole header instead of a hardcoded line range. The range is what
# hid the drift: the header promised .runs/ and docs/EXPERIMENTS.jsonl, paths
# that appear nowhere else in the code, and anything added past line 12 would
# not have shown up on the help screen where the error would be visible.
usage() {
  # Stop at the first line that is not a comment, whatever it is. Keying on
  # `set -` assumed the header is always followed by exactly that; move the
  # set, indent it, or drop it, and the internal comments leak into --help
  # while awk still exits 0, so the broken help reads as success.
  awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' \
    "$(readlink -f "${BASH_SOURCE[0]}")"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  run|top)  exec bash "$LAB_DIR/ledger.sh"  "$cmd" "$@" ;;
  capsule)  exec bash "$LAB_DIR/capsule.sh" "$@" ;;
  board)    exec bash "$LAB_DIR/board.sh"   "$@" ;;
  fail)     exec bash "$LAB_DIR/fail.sh"    "$@" ;;
  data)     exec bash "$LAB_DIR/data.sh"    "$@" ;;
  ""|-h|--help|help) usage; exit 0 ;;
  *) printf 'oma-lab: unknown command: %s\n\n' "$cmd" >&2; usage >&2; exit 2 ;;
esac
